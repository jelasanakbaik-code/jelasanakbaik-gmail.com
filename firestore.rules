rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: public readable, writable for store management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: customers can create orders and upload payment proof; admin can manage
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Customers CRM collection: readable and writable for store CRM sync
    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
